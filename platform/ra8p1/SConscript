import os
from building import *
cwd = GetCurrentDir()
ws281x_diagnostic = Glob('ws281x_diag.c')
src = Glob('*.cpp') + Glob('npu_load.c') + Glob('pdm_capture.c') + Glob('pdm_target.c') + Glob('arm_numeric_probe.c') + Glob('useful_npu_probe.c') + Glob('coexist_probe.c') + Glob('ws2816_gpio_emit.c') + Glob('titan_ram_diag.c') + Glob('k1_exact_stream.c') + Glob('ws281x_waveform.c') + Glob('k1_shared_snapshot.c') + Glob('ws281x_gpt_dma.c') + Glob('ws281x_gpt_dma_hw.c') + Glob('k1_rate_adapt.c') + Glob('k1_asrc_24k.c') + Glob('k1_status_led.c') + Glob('titan_status_gpio.c') + Glob('titan_led2_phy.c')
src += ws281x_diagnostic
k1_root = os.path.join(cwd, 'k1')
k1_cpp = []
if os.path.isdir(k1_root):
    for directory, _, files in os.walk(k1_root):
        k1_cpp += [os.path.join(directory, f) for f in files if f.endswith('.cpp')]
if not k1_cpp:
    print('K1Scalar: in-tree k1/ walk is empty. Live images are built by '
          'scripts/build_scalar.py, which stages src/k1 here first.')
    raise Exception('K1_SCONSCRIPT_MISSING_K1')
src += k1_cpp
group = DefineGroup('K1Scalar', src, depend=[''], CPPPATH=[cwd, os.path.join(cwd, 'k1'), os.path.join(cwd, 'models'), os.path.join(cwd, 'p4')],
                    LOCAL_CXXFLAGS=' -std=c++17 -fno-exceptions -fno-rtti -fno-threadsafe-statics')
objects = [group]
model_sconscript = os.path.join(cwd, 'models', 'SConscript')
if os.path.isfile(model_sconscript):
    objects += SConscript(model_sconscript)
p4_sconscript = os.path.join(cwd, 'p4', 'SConscript')
if os.path.isfile(p4_sconscript):
    objects += SConscript(p4_sconscript)
Return('objects')
