{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spectrasynq:k1:control-profile:2",
  "title": "K1 control profile draft, version 2",
  "description": "Structural schema for editable channel-first profiles. Cross-field rules (registry lookup, scope, legal domain, log domains, response-policy admission, relative admission, duplicate targets, capacities, UTF-8 byte lengths) are enforced by scripts/compile_control_profile.py and core/control/v2/profile_compiler. Extends the R2 host schema deliberately: registry-keyed parameters, explicit custom pages and explicit unused slots replace the fixed fifteen semantics and two pages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_revision",
    "label",
    "registry",
    "channels"
  ],
  "properties": {
    "schema": {
      "const": "k1.control-profile/2"
    },
    "profile_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 23
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "major"
      ],
      "properties": {
        "schema": {
          "const": "k1.control-registry/2"
        },
        "major": {
          "const": 2
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "slot_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "pages"
      ],
      "properties": {
        "channel": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "kind",
        "label",
        "slots"
      ],
      "properties": {
        "page_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "kind": {
          "enum": [
            "perform",
            "colour",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "slots": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/binding"
              },
              {
                "$ref": "#/$defs/unused"
              }
            ]
          }
        }
      }
    },
    "unused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "unused"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/slot_number"
        },
        "unused": {
          "const": true
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "parameter",
        "range",
        "mapping",
        "inverted",
        "modality",
        "input",
        "quantisation",
        "response",
        "takeover"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/slot_number"
        },
        "parameter": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,23}$"
        },
        "label": {
          "type": "string",
          "maxLength": 15
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "linear",
                "log",
                "exponent"
              ]
            },
            "exponent": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            }
          }
        },
        "inverted": {
          "type": "boolean"
        },
        "modality": {
          "enum": [
            "absolute",
            "relative"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "hysteresis"
          ],
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 2,
              "maximum": 65536
            },
            "hysteresis": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            }
          }
        },
        "quantisation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "response": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,23}$"
        },
        "takeover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "tolerance"
          ],
          "properties": {
            "mode": {
              "enum": [
                "pickup",
                "jump",
                "range"
              ]
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.05
            }
          }
        },
        "relative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gain",
            "acceleration",
            "max_rate"
          ],
          "properties": {
            "gain": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16
            },
            "acceleration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exponent",
                "reference_velocity",
                "max_multiplier"
              ],
              "properties": {
                "exponent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "reference_velocity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "max_multiplier": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 64
                }
              }
            },
            "max_rate": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mapping": {
                "properties": {
                  "kind": {
                    "const": "exponent"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "mapping": {
                "required": [
                  "exponent"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "mapping": {
                "not": {
                  "required": [
                    "exponent"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mapping": {
                "properties": {
                  "kind": {
                    "const": "log"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "range": {
                "properties": {
                  "min": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "modality": {
                "const": "relative"
              }
            }
          },
          "then": {
            "required": [
              "relative"
            ],
            "properties": {
              "takeover": {
                "properties": {
                  "mode": {
                    "const": "jump"
                  },
                  "tolerance": {
                    "const": 0
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "relative"
              ]
            }
          }
        }
      ]
    }
  }
}
