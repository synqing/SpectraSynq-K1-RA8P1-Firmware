# Build outputs
build/
out/
Debug/
Release/
*.elf
*.hex
*.bin
*.map
*.o
*.a

# IDE / vendor generated state
.DS_Store
.vscode/
.settings/
.metadata/
*.launch

# Python / harness
__pycache__/
*.pyc
.venv/

# Scratch is deliberately non-authority
scratch/*
!scratch/.gitkeep

# Host MCP / session noise (not firmware)
/combined.log
/error.log

# Vendor stage trees and broker bulk (not programme source)
docs/evidence/**/stage/
docs/evidence/**/broker-live/broker.jsonl
docs/evidence/**/broker-live/broker-stdout.log
tools/serial-studio.zip
tools/serial-studio/.locks/
platform/ra8p1/Archive.zip
*.sconsign.dblite

# Local agent scratch (builds, captures and video). The scratch/ rule does not match this name.
_scratch/

