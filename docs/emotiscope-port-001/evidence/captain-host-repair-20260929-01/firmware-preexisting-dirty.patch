+def _decode_donor_body(body: bytes) -> dict | None:
+    if len(body) != donor.STATE_BYTES:
+        return None
+    state = donor.decode_state(body)
+    if state["magic"] != donor.STATE_MAGIC or state["reserved"] != b"\x00" * 20:
+        return None
+    return donor_public_state(state)
