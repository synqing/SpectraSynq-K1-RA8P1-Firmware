+class PersistentRequestIds:
+    """Reserve disjoint wire-ID blocks across process restart; never wrap.
+
+The old experimental clients used small IDs. The production host owns the
+0x40000000..0xffffffff range, persisted independently of scenes/assignments.
+A damaged counter stops allocation rather than silently reusing an ID.
+"""
+    BASE = 0x40000000
+    BLOCK = 65536
+
+    def __init__(self, path: Path):
+        self.path = Path(path)
+        self.current = self.limit = 0
+        self._reserve()
+
+    def _reserve(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        lock_path = self.path.with_suffix(self.path.suffix + ".lock")
+        with os.fdopen(os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600), "a+") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            if self.path.exists():
+                data = json.loads(self.path.read_text())
+                start = data.get("next")
+                if data.get("version") != 1 or type(start) is not int or start < self.BASE:
+                    raise ValueError("invalid persisted Emotiscope request-ID counter")
+            else:
+                start = self.BASE
+            end = start + self.BLOCK
+            if end > 0x100000000:
+                raise ValueError("Emotiscope wire-ID space exhausted; refusing reuse")
+            temp = self.path.with_name(self.path.name + "." + uuid.uuid4().hex + ".tmp")
+            with os.fdopen(os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600), "w") as out:
+                json.dump({"version": 1, "next": end}, out)
+                out.flush()
+                os.fsync(out.fileno())
+            os.replace(temp, self.path)
+            # Flush directory metadata before any reserved ID is used.
+            fd = os.open(self.path.parent, os.O_RDONLY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+            self.current, self.limit = start, end
+
+    def next(self) -> int:
+        if self.current >= self.limit:
+            self._reserve()
+        value = self.current
+        self.current += 1
+        return value
+
+
+class LabelledCapture:
+    """A human selects a physical label before its isolated gesture.
+
+Raw callbacks are retained before gesture coalescing. Overflow, timeout,
+wrong identities and insufficient movement cannot qualify a control.
+Proof belongs to this exact transport epoch and is never auto-loaded.
+"""
+    MAX_EVENTS = 8192
+    MAX_SECONDS = 120
+
+    def __init__(self, profile: dict, evidence: Path, endpoint: str):
+        self.rules = {**profile["bindings"], **profile.get("witnesses", {})}
+        self.evidence = Path(evidence)
+        self.endpoint = endpoint
+        self.epoch = None
+        self._lock = threading.RLock()
+        self._capture = None
+        self.proofs = {}
+        self.last_result = None
+
+    @property
+    def active(self):
+        with self._lock:
+            return self._capture is not None
+
+    def qualified(self, label):
+        with self._lock:
+            return label in self.proofs and self.proofs[label]["epoch"] == self.epoch
+
+    def invalidate(self, epoch):
+        with self._lock:
+            self.epoch = epoch
+            self.proofs.clear()
+            self._capture = None
+            self.last_result = {"ok": False, "reason": "transport epoch changed; fresh labelled capture required"}
+
+    def begin(self, label):
+        with self._lock:
+            if label not in self.rules:
+                raise ValueError("unknown physical control label")
+            if self._capture is not None:
+                raise ValueError("finish or cancel the current labelled capture first")
+            self.proofs.pop(label, None)
+            self._capture = {"label": label, "started_ns": time.monotonic_ns(),
+                             "epoch": self.epoch, "rows": [], "dropped": 0}
+            return {"state": "capture_active", "label": label, "writes_held": True}
+
+    def observe(self, channel, cc, value):
+        with self._lock:
+            cap = self._capture
+            if cap is None:
+                return
+            now = time.monotonic_ns()
+            if len(cap["rows"]) >= self.MAX_EVENTS or now-cap["started_ns"] > self.MAX_SECONDS*1_000_000_000:
+                cap["dropped"] += 1
+                return
+            cap["rows"].append({"mono_ns": now, "channel": int(channel), "cc": int(cc), "value": int(value)})
+
+    def cancel(self):
+        with self._lock:
+            self._capture = None
+            self.last_result = {"ok": False, "reason": "operator cancelled capture"}
+            return self.last_result
+
+    def finish(self):
+        with self._lock:
+            cap = self._capture
+            if cap is None:
+                raise ValueError("no active labelled capture")
+            # Keep writes held until validation and evidence persistence finish.
+            cap = {**cap, "rows": list(cap["rows"])}
+            rule = self.rules[cap["label"]]
+            expected = (int(rule["channel"]), int(rule["cc"]))
+            identities = {(r["channel"], r["cc"]) for r in cap["rows"]}
+            values = {r["value"] for r in cap["rows"]}
+            elapsed = (time.monotonic_ns()-cap["started_ns"])/1_000_000_000
+            kind = rule.get("kind", "button")
+            gesture = (len(values) >= 3 and min(values) <= 16 and max(values) >= 111) if kind == "absolute" else {0,127}.issubset(values)
+            ok = (not cap["dropped"] and elapsed <= self.MAX_SECONDS and identities == {expected}
+                  and gesture and cap["epoch"] == self.epoch)
+            result = {"version": 1, "ok": bool(ok), "label": cap["label"], "endpoint": self.endpoint,
+                      "epoch": cap["epoch"], "expected": list(expected), "observed": [list(i) for i in sorted(identities)],
+                      "events": len(cap["rows"]), "dropped": cap["dropped"], "seconds": elapsed,
+                      "reason": "isolated labelled gesture captured" if ok else "wrong/mixed identity, insufficient sweep, timeout or dropped evidence"}
+        self.evidence.mkdir(parents=True, exist_ok=True)
+        stem = cap["label"] + "-" + uuid.uuid4().hex
+        raw = b"".join((json.dumps(row,sort_keys=True)+"\n").encode() for row in cap["rows"])
+        raw_path = self.evidence / (stem + ".jsonl")
+        with os.fdopen(os.open(raw_path, os.O_CREAT|os.O_EXCL|os.O_WRONLY, 0o600), "wb") as out:
+            out.write(raw)
+        result["raw_path"] = str(raw_path)
+        result["raw_sha256"] = hashlib.sha256(raw).hexdigest()
+        with self._lock:
+            # A reconnect during persistence invalidates, rather than admits, it.
+            if self.epoch != cap["epoch"]:
+                result.update(ok=False, reason="transport changed during capture persistence")
+            self._capture = None
+            self.last_result = result
+            if result["ok"]:
+                self.proofs[cap["label"]] = result
+        with os.fdopen(os.open(self.evidence/(stem+".json"), os.O_CREAT|os.O_EXCL|os.O_WRONLY, 0o600), "w") as out:
+            json.dump(result,out,indent=2)
+        return result
+
+    def status(self):
+        with self._lock:
+            return {"active": self._capture is not None,
+                    "label": self._capture["label"] if self._capture else None,
+                    "events": len(self._capture["rows"]) if self._capture else 0,
+                    "qualified": sorted(self.proofs), "last_result": self.last_result,
+                    "collision_required": [n for n in ("Fader1","Fader4","R5","R8") if not self.qualified(n)]}
