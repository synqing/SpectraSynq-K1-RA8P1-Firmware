+class TransportFence:
+    """A loss/epoch change clears intent before fresh read-only attachment."""
+    def __init__(self, engine, inbox, capture, transport):
+        self.engine, self.inbox = engine, inbox
+        self.capture, self.transport = capture, transport
+        self.epoch = None
+        self.attached = False
+        self.retry_at = 0.0
+        self.error = None
+
+    def hold(self, reason):
+        self.engine.abandon()
+        self.engine._reset_gestures()
+        self.engine.ready = False
+        self.engine.last_error = reason
+        self.inbox.drain()
+        if self.attached or self.epoch is not None:
+            self.capture.invalidate(None)
+        self.epoch = None
+        self.attached = False
+        self.error = reason
+
+    def check(self, epoch, now):
+        if epoch is None:
+            self.hold("selected MIDI transport unavailable or stale")
+            return False
+        if self.attached and epoch == self.epoch and self.engine.ready:
+            return True
+        if epoch != self.epoch:
+            self.hold("transport epoch changed; reconciling")
+            self.epoch = epoch
+            self.capture.invalidate(epoch)
+            self.retry_at = 0.0
+        if now < self.retry_at:
+            self.inbox.drain()
+            return False
+        self.retry_at = now + 1.0
+        self.inbox.drain()
+        try:
+            reply = self.engine.attach(now)
+        except (OSError, ConnectionError, TimeoutError) as exc:
+            self.transport.close()
+            self.error = str(exc)
+            return False
+        if not self.engine.ready or not reply.get("ok"):
+            self.error = self.engine.last_error
+            return False
+        # Events arriving before readback never act on the new attachment.
+        self.inbox.drain()
+        self.attached = True
+        self.error = None
+        return False
+
