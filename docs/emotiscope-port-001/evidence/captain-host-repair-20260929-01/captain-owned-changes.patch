+
+    def finish(self):
+        with self.owner:
+            result = self.capture.finish()
+            self.engine.abandon()
+            self.engine._reset_gestures()
+            self.inbox.drain()
+            self.engine.faders_armed = all(self.capture.qualified(n) for n in ("Fader1","Fader4","R5","R8"))
+            return result
+
+    def cancel(self):
+        with self.owner:
+            result = self.capture.cancel()
+            self.engine.abandon()
+            self.engine._reset_gestures()
+            self.inbox.drain()
+            return result
