+"""Regressions for reproduced September 29 integration faults, no hardware I/O."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from test_emotiscope_strategy import DonorDouble, engine, patches, press, public_state
+from smc_titan_control.emotiscope_engine import load_profile
+from smc_titan_control.emotiscope_live import GestureInbox, TransportFence, connected_ble_epoch
+from smc_titan_control.emotiscope_session import LabelledCapture, PersistentRequestIds
+
+
+class Repairs(unittest.TestCase):
+    def test_duplicate_down_needs_release_before_a_second_toggle(self):
+        donor=DonorDouble(); found=engine(donor)
+        found.observe(0,28,0)
+        for _ in range(4): found.observe(0,28,127)
+        found.tick(.1); found.tick(.2)
+        self.assertEqual([p[3] for p in patches(donor)],[{"mirror_mode":False}])
+        press(found,0,28);found.tick(.3)
+        self.assertEqual(patches(donor)[-1][3],{"mirror_mode":True})
+
+    def test_scene_then_next_uses_the_confirmed_scene_mode(self):
+        donor=DonorDouble();found=engine(donor)
+        found.discrete.append(("patch",{"current_mode":5}))
+        press(found,0,58);found.tick(.1);found.tick(.2)
+        self.assertEqual([p[3]["current_mode"] for p in patches(donor)],[5,6])
+
+    def test_defaults_then_next_uses_defaults_not_prior_mode(self):
+        donor=DonorDouble(public_state(mode=6));found=engine(donor)
+        found.discrete.append(("defaults",None));press(found,0,58)
+        found.tick(.1);found.tick(.2)
+        self.assertEqual([p[3]["current_mode"] for p in patches(donor)],[1,2])
+
+    def test_writer_busy_is_not_a_successful_attachment(self):
+        donor=DonorDouble();donor.hello=lambda:{"ok":False,"error":"writer_busy","session":"other"}
+        found=engine(donor)
+        self.assertFalse(found.ready)
+        self.assertEqual(found.last_error,"writer_busy")
+        self.assertEqual(donor.ops,[])
+
+    def test_request_ids_never_restart_at_one_or_overlap_reserved_blocks(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p=Path(tmp)/"ids.json";a=PersistentRequestIds(p);b=PersistentRequestIds(p)
+            aa=[a.next() for _ in range(10)];bb=[b.next() for _ in range(10)]
+            self.assertEqual(len(set(aa+bb)),20)
+            self.assertGreater(bb[0],aa[-1])
+            c=PersistentRequestIds(p);self.assertGreater(c.next(),bb[-1])
+            self.assertEqual(p.stat().st_mode&0o777,0o600)
+            p.write_text('{"version":1,"next":true}')
+            with self.assertRaises(ValueError): PersistentRequestIds(p)
+
+    def test_ble_requires_fresh_powered_on_exact_peripheral_and_epoch(self):
+        spec=load_profile()["endpoints"]["SMC-Mixer Bluetooth"]
+        good={"fresh":True,"state":5,"epoch":7,"connected_ids":[spec["peripheral_id"]]}
+        self.assertEqual(connected_ble_epoch(good,spec),("bluetooth",7))
+        for change in ({"fresh":False},{"state":4},{"epoch":None},{"connected_ids":[]}):
+            self.assertIsNone(connected_ble_epoch({**good,**change},spec))
+
+    def capture(self, cap, name):
+        r=cap.rules[name];cap.begin(name)
+        values=[0,64,127,0] if r.get("kind")=="absolute" else [127,0]
+        for value in values:cap.observe(r["channel"],r["cc"],value)
+        result=cap.finish();self.assertTrue(result["ok"],result)
+        self.assertTrue(Path(result["raw_path"]).exists())
+        return result
+
+    def test_only_four_labelled_isolated_captures_arm_collision_faders(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=DonorDouble();e=engine(d);cap=LabelledCapture(load_profile(),Path(tmp),"test-labelled-fixture")
+            e.qualification=cap;cap.invalidate(("fixture",1))
+            e.observe(0,40,127);e.observe(0,43,32)
+            self.assertFalse(e.faders_armed)
+            for name in ("Fader1","Fader4","R5"):
+                self.capture(cap,name)
+                self.assertFalse(e._fader_write_allowed("Fader1"))
+            self.capture(cap,"R8")
+            self.assertTrue(e._fader_write_allowed("Fader1"))
+            e.observe(0,40,64);e.tick(.1)
+            self.assertEqual(set(patches(d)[-1][3]),{"brightness"})
+            cap.invalidate(("fixture",2))
+            self.assertFalse(e._fader_write_allowed("Fader1"))
+
+    def test_mixed_or_insufficient_capture_never_qualifies(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cap=LabelledCapture(load_profile(),Path(tmp),"fixture")
+            cap.begin("Fader1")
+            for v in (0,64,127):cap.observe(0,40,v)
+            cap.observe(1,40,127)
+            self.assertFalse(cap.finish()["ok"])
+            self.assertFalse(cap.qualified("Fader1"))
+            cap.begin("Fader1");cap.observe(0,40,64)
+            self.assertFalse(cap.finish()["ok"])
+
+    def test_capture_overflow_invalidates_instead_of_dropping_evidence_silently(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cap=LabelledCapture(load_profile(),Path(tmp),"fixture");cap.MAX_EVENTS=2
+            cap.begin("Fader1")
+            for v in (0,64,127):cap.observe(0,40,v)
+            result=cap.finish()
+            self.assertFalse(result["ok"]);self.assertEqual(result["dropped"],1)
+
+    def test_capture_holds_queued_pause_defaults_and_other_faders_without_blackout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=DonorDouble();e=engine(d);cap=LabelledCapture(load_profile(),Path(tmp),"fixture")
+            e.qualification=cap;cap.begin("Fader1")
+            press(e,0,53);e.request_defaults();e.observe(0,41,0);e.observe(0,41,127)
+            self.assertEqual(e.tick(.1)["qualification"],"writes_held")
+            self.assertEqual(patches(d),[]);self.assertTrue(e.state["emission_enabled"])
+            cap.cancel();e.tick(.2);self.assertEqual(patches(d),[])
+
+    def test_raw_capture_happens_before_inbox_coalescing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cap=LabelledCapture(load_profile(),Path(tmp),"fixture");cap.begin("Fader1")
+            inbox=GestureInbox({(0,40)},cap)
+            for v in range(128):inbox.receive(SimpleNamespace(type="control_change",channel=0,control=40,value=v))
+            groups=inbox.drain();self.assertLessEqual(len(groups[0][1]),4)
+            result=cap.finish();self.assertTrue(result["ok"]);self.assertEqual(result["events"],128)
+            self.assertEqual(len(Path(result["raw_path"]).read_text().splitlines()),128)
+
+    def test_transport_loss_drops_old_intent_and_new_epoch_reads_before_writing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=DonorDouble();e=engine(d);cap=LabelledCapture(load_profile(),Path(tmp),"fixture")
+            e.qualification=cap;inbox=GestureInbox(set(),cap)
+            transport=SimpleNamespace(close=lambda:None)
+            f=TransportFence(e,inbox,cap,transport)
+            self.assertFalse(f.check(("bluetooth",1),0))
+            self.assertTrue(f.check(("bluetooth",1),.1))
+            press(e,0,53);e.dirty["warmth"]=1
+            self.assertFalse(f.check(None,.2));self.assertFalse(e.ready)
+            self.assertFalse(e.discrete);self.assertFalse(e.dirty)
+            self.assertFalse(f.check(("bluetooth",2),.3))
+            self.assertTrue(f.check(("bluetooth",2),.4))
+            e.tick(.5);self.assertEqual(patches(d),[])
+            self.assertTrue(e.state["emission_enabled"])
+
+if __name__=="__main__": unittest.main()
