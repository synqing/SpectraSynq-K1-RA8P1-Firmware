+class BoundedMidiInput:
+    """Callback publishes immutable messages; the owner drains one finite batch.
+
+    Absolute controls retain extrema and the latest value for soft pickup.
+    Other messages retain FIFO order
+    up to a fixed cap; every overflow is counted. No broker or serial work occurs
+    on the MIDI callback thread.
+    """
+    absolute_capacity = 128
+    other_capacity = 32
+
+    def __init__(self):
+        self.port = None
+        self._lock = threading.Lock()
+        self._absolute = OrderedDict()
+        self._other = deque()
+        self.received = self.coalesced = self.dropped = self.high_water = 0
+        self._closed = False
+
+    def receive(self, msg):
+        absolute = msg.type in {"pitchwheel", "control_change"}
+        key = (msg.type, getattr(msg, "channel", 0), getattr(msg, "control", None))
+        with self._lock:
+            if self._closed:
+                return
+            self.received += 1
+            if msg.type == "sysex" and len(msg.data) > 256:
+                self.dropped += 1
+                return
+            if absolute:
+                if key in self._absolute:
+                    self.coalesced += 1
+                elif len(self._absolute) == self.absolute_capacity:
+                    self._absolute.popitem(last=False)
+                    self.dropped += 1
+                record = (self.received, msg.copy())
+                previous = self._absolute.get(key)
+                value = lambda item: getattr(item[1], "pitch", getattr(item[1], "value", 0))
+                candidates = [record] if previous is None else [*previous, record]
+                self._absolute[key] = (min(candidates, key=value), max(candidates, key=value), record)
+                self._absolute.move_to_end(key)
+            else:
+                if len(self._other) == self.other_capacity:
+                    self._other.popleft()
+                    self.dropped += 1
+                self._other.append((self.received, msg.copy()))
+            self.high_water = max(self.high_water, 3*len(self._absolute)+len(self._other))
