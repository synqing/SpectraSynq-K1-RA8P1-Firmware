@@ -809,8 +809,42 @@ void InhouseWaveformRenderer::fadeV9(bool mode32, bool silent, float dt) noexcep
 // Deposit: level drives amplitude and a bounded triangular width. A pixel takes the
 // new intensity AND its colour only where the deposit exceeds the decayed value, so
 // trails keep their deposited colour and no hue is mixed per channel.
+// DBS pilot deposit contrast, gain = 1 - s * (1 - attack). It only scales the amplitude of
+// new material; width, position, scroll, release, stored history and palette coordinates are
+// untouched. Off, zero strength, an invalid/foreign record, stale input or quiet returns exactly
+// 1.0F so depositV9 takes the unchanged arithmetic. A repeated read of one publication has
+// fresh = false and therefore attack 0: continuing material, never a replayed attack.
+float InhouseWaveformRenderer::detailContrastV9(const InhouseWaveformAudio& audio,
+    const InhouseWaveformControls& controls, bool fresh, bool silent) noexcept {
+  observation_.detail_attack = 0.0F;
+  observation_.detail_gain = 1.0F;
+  const auto arm = static_cast<InhouseDetailArm>(controls.detail_arm);
+  if (arm == InhouseDetailArm::kOff || controls.detail_arm > 4U) return 1.0F;
+  if (!(controls.detail_strength > 0.0F) || !std::isfinite(controls.detail_strength)) return 1.0F;
+  if (!fresh || silent || !audio.detail.valid || audio.detail.schema != kInhouseDetailSchema) return 1.0F;
+  const auto calibrated = [](float x, const InhouseDetailCalibration& c) {
+    const float span = c.p95 - c.p50;
+    return std::isfinite(x) && span > 0.0F ? clamp01((x - c.p50) / span) : 0.0F;
+  };
+  float attack = 0.0F;
+  if (audio.detail.fresh) {
+    switch (arm) {
+      case InhouseDetailArm::kOnset: attack = std::isfinite(audio.detail.onset) ? clamp01(audio.detail.onset) : 0.0F; break;
+      case InhouseDetailArm::kFullBank: attack = calibrated(audio.detail.full_bank, kInhouseDetailCalFullBank); break;
+      case InhouseDetailArm::kStatic16: attack = calibrated(audio.detail.static16, kInhouseDetailCalStatic16); break;
+      case InhouseDetailArm::kAdaptive16: attack = calibrated(audio.detail.adaptive16, kInhouseDetailCalAdaptive16); break;
+      default: break;
+    }
+  }
+  const float s = std::min(kInhouseDetailMaxStrength, controls.detail_strength);
+  const float gain = 1.0F - s * (1.0F - attack);
+  observation_.detail_attack = attack;
+  observation_.detail_gain = gain;
+  return gain;
+}
