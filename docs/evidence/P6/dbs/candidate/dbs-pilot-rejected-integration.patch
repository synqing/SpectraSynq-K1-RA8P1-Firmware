+"""DBS pilot: AdaptiveSpectralDetail passes its nine host cases, compiles warning-free, and each
+planted fault turns its named case red (Titan_DBS_Translation.html section 2)."""
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+HEADER = ROOT / "platform/ra8p1/adaptive_spectral_detail.h"
+SOURCE = ROOT / "platform/ra8p1/adaptive_spectral_detail.cpp"
+TEST = ROOT / "tests/host/test_adaptive_spectral_detail.cpp"
+CASES = [f"test{n}" for n in range(1, 10)]
+
+
+def build_and_run(tmp: Path, extra: list[str] | None = None, src_dir: Path | None = None):
+    """Compile the C++ test against src_dir (default: the real sources) and run it."""
+    test_cpp = src_dir / TEST.name if src_dir else TEST
+    src_dir = src_dir or ROOT / "platform/ra8p1"
+    exe = tmp / "test_adaptive_spectral_detail"
+    build = subprocess.run(
+        ["c++", "-std=c++17", "-O2", "-fno-fast-math", "-Wall", "-Wextra", "-DK1_ADAPTIVE_DETAIL_TEST_HOOKS",
+         *(extra or []), "-I", str(src_dir), "-I", str(ROOT / "platform/ra8p1"), "-I", str(ROOT / "src"),
+         "-I", str(ROOT / "src/k1"), str(test_cpp), str(src_dir / SOURCE.name), "-o", str(exe)],
+        capture_output=True, text=True)
+    if build.returncode != 0:
+        return build
+    return subprocess.run([str(exe)], capture_output=True, text=True, timeout=120)
+
+
+def test_product_compiles_warning_free(tmp_path):
+    for defines in ([], ["-DK1_ADAPTIVE_DETAIL_TEST_HOOKS"]):
+        r = subprocess.run(
+            ["c++", "-std=c++17", "-O2", "-fno-fast-math", "-fno-exceptions", "-fno-rtti", "-Wall", "-Wextra",
+             "-Wpedantic", "-Wshadow", "-Wdouble-promotion", "-Wconversion", "-Wsign-conversion", "-Werror",
+             *defines, "-I", str(ROOT / "platform/ra8p1"), "-I", str(ROOT / "src"), "-I", str(ROOT / "src/k1"),
+             "-c", str(SOURCE), "-o", str(tmp_path / "asd.o")], capture_output=True, text=True)
+        assert r.returncode == 0, r.stderr
+
+
+def test_all_cases_pass(tmp_path):
+    r = build_and_run(tmp_path)
+    assert r.returncode == 0, r.stdout + r.stderr
+    for case in CASES:
+        assert re.search(rf"^{case} .*: ok$", r.stdout, re.M), r.stdout
+
+
+def test_all_cases_pass_sanitised(tmp_path):
+    r = build_and_run(tmp_path, ["-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-g"])
+    assert r.returncode == 0, r.stdout + r.stderr
+
+
+FORBIDDEN = re.compile(r"std::(vector|string|map|function|shared_ptr|unique_ptr|deque|list)\b|\bnew\b|"
+                       r"\bmalloc\s*\(|\bthrow\b|\btry\b|dynamic_cast|typeid")
+
+
+def forbidden_tokens(text: str) -> list[str]:
+    code = re.sub(r"//[^\n]*", "", text)
+    return [m.group(0) for m in FORBIDDEN.finditer(code)]
+
+
+def test_no_allocation_in_module():
+    for path in (HEADER, SOURCE):
+        assert forbidden_tokens(path.read_text()) == [], path
+
+
+def test_allocation_grep_goes_red_on_planted_vector():
+    planted = HEADER.read_text().replace("  float alpha_ = 0.0F;", "  std::vector<float> scratch_;\n  float alpha_ = 0.0F;")
+    assert forbidden_tokens(planted), "grep did not flag a planted std::vector member"
+
+
+# (name, file, [(old, new), ...], case expected to go red or "compile").
+MUTATIONS = [
+    ("static_not_5555", HEADER, [("kStaticCuts{5U, 10U, 15U}", "kStaticCuts{5U, 10U, 14U}")], "test1"),
+    ("group_overlap", SOURCE, [("group.last_channel = static_cast<std::uint8_t>(end - 1U);",
+                                "group.last_channel = static_cast<std::uint8_t>(end);")], "test1"),
+    ("min_width_1", HEADER, [("kMinGroupWidth = 2U;", "kMinGroupWidth = 1U;")], "compile"),
+    ("negative_change", SOURCE, [("std::max(0.0F, x - log_magnitude_[i])", "(x - log_magnitude_[i])")], "test2"),
+    ("prime_emits_change", SOURCE, [("const float d = prime ? 0.0F : std::max(", "const float d = std::max("),
+                                    ("if (prime || input.quiet) change_.fill", "if (input.quiet) change_.fill")],
+     "test2"),
+    ("duplicate_advances", SOURCE, [("input.generation <= generation_) return false;",
+                                     "input.generation < generation_) return false;")], "test3"),
+    ("gap_undetected", SOURCE, [("input.generation == generation_ + 1U &&", "input.generation > generation_ &&")],
+     "test3"),
+    ("sample_gap_undetected", SOURCE, [("(hop_samples_ == 0U || hop == hop_samples_);", "true;")], "test3"),
+    ("reset_keeps_layout", SOURCE, [("state = adaptive_detail::BlockSelection{};", "state.streak = 0U;")], "test4"),
+    ("group_slot_differencing", SOURCE, [("group.mean_positive_change = sum_change * inverse;",
+                                          "group.mean_positive_change = std::max(0.0F, sum_log * inverse - "
+                                          "group.mean_log_magnitude);")], "test5"),
+    ("one_update_switches", HEADER, [("kConsecutiveUpdates = 2U;", "kConsecutiveUpdates = 1U;")], "test6"),
+    ("hysteresis_4pct", HEADER, [("kHysteresisRatio = 1.10F;", "kHysteresisRatio = 1.04F;")], "test6"),
+    ("tie_prefers_later", SOURCE, [("if (score > best_score) {", "if (score >= best_score) {")], "test6"),
+    ("tie_ignores_current", SOURCE, [("Cuts best = current;\n  float best_score = partitionScore(scores, current);",
+                                      "Cuts best = kLegalSplits[0];\n  float best_score = partitionScore(scores, best);")],
+     "test6"),
+    ("tiny_signal_normalised", HEADER, [("kNormFloor = 1.0e-6F;", "kNormFloor = 1.0e-9F;")], "test6"),
+    ("quiet_not_gated", SOURCE, [("if (prime || input.quiet) change_.fill", "if (prime) change_.fill")], "test7"),
+    ("quiet_freezes_history", SOURCE, [("    log_magnitude_[i] = x;\n", "    if (!input.quiet) log_magnitude_[i] = x;\n")],
+     "test7"),
+    ("quiet_keeps_streak", SOURCE, [("for (auto& state : selection_) state.streak = 0U;", "(void)selection_;")],
+     "test7"),
+    ("centroid_unweighted", SOURCE, [("group.centroid_hz = weighted ? sum_weighted / sum_magnitude :",
+                                      "group.centroid_hz = false ? sum_weighted / sum_magnitude :")], "test2"),
+    ("invalid_group_reads_data", SOURCE, [("        if (!group.valid) continue;\n", "")], "test2"),
+    ("selection_every_hop", HEADER, [("kSelectionPeriodHops = 4U;", "kSelectionPeriodHops = 1U;")], "test8"),
+    ("selection_every_3", HEADER, [("kSelectionPeriodHops = 4U;", "kSelectionPeriodHops = 3U;")], "test8"),
+    ("record_not_trivially_copyable", HEADER, [("struct DetailRecord final {\n",
+                                                "struct DetailRecord final {\n  DetailRecord() = default;\n"
+                                                "  DetailRecord(const DetailRecord& o) noexcept : epoch(o.epoch) {}\n")],
+     "compile"),
+]
+
+
+@pytest.mark.parametrize("name,path,edits,expected", MUTATIONS, ids=[m[0] for m in MUTATIONS])
+def test_planted_fault_goes_red(tmp_path, name, path, edits, expected):
+    for source in (HEADER, SOURCE, TEST):
+        shutil.copy(source, tmp_path / source.name)
+    target = tmp_path / path.name
+    text = target.read_text()
+    for old, new in edits:
+        # A refactor that loses the anchor must fail here, not silently pass the mutation.
+        assert text.count(old) == 1, f"{name}: anchor not unique: {old!r}"
+        text = text.replace(old, new)
+    target.write_text(text)
+    r = build_and_run(tmp_path, src_dir=tmp_path)
+    assert r.returncode != 0, f"{name} stayed green:\n{r.stdout}"
+    if expected == "compile":
+        assert "error" in r.stderr, r.stdout + r.stderr
+    else:
+        assert re.search(rf"^{expected} .*: FAIL$", r.stdout, re.M), f"{name} did not fail {expected}:\n{r.stdout}"
diff --git a/tests/host/p6_dbs_probe.cpp b/tests/host/p6_dbs_probe.cpp
new file mode 100644
index 0000000..35b3514
--- /dev/null
+++ b/tests/host/p6_dbs_probe.cpp
@@ -0,0 +1,219 @@
+// DBS pilot host replay (P6-DBS-PILOT-CRITERIA-v1). Product v9 path: 40 kHz int16 mono PCM ->
+// k1_poly24 (24 kHz / 180) -> InhouseAudio (with the shared spectral-detail producer) -> one
+// InhouseWaveformRenderer per board at the 10 ms render period, v9 boot composition controls
+// (lower mode 32 palette 32, upper mode 18 palette 39, speed 0.5, mirror on), board 0 detail
+// arm/strength from argv, board 1 always off. Built WITHOUT K1_INHOUSE_V9_HOST_VARIANTS, so
+// the renderer constants are the product constants. Not modelled: donor admission, display
+// stage and the wire packer (identical for every arm; the deposit is the measured operation).
+//
+// Host-only additions, never in the product image:
+//   arm 1 (onset): OnsetBeat over each accepted publication's pre-gain linear_shape, exactly as
+//     tests/host/p6_onset_pre_agc.cpp; its transient_strength is the maximum over the
+//     generations board 0 has not read, injected into InhouseWaveformAudio::detail.onset.
+//   plants (metric validity, arm 2 only): uniform | random | oracle overwrite detail.full_bank
+//     with p50 / seeded U(p50,p95) / (p95 within 0..30 ms after a listed onset else p50).
+//
+//   p6_dbs_probe in.s16 out_prefix arm strength [plant onsets.txt offset_s scale]
+// Writes <out_prefix>.ticks.csv (both boards), <out_prefix>.hops.csv (producer record per
+// accepted hop) and <out_prefix>.frames.bin (board 0 then board 1 Pixel16 per tick).
+#include "inhouse_audio.h"
+#include "core/audio/onset_beat.h"
+#include "core/visual/inhouse_waveform.h"
+#include "k1_poly24.h"
+#include "pdm_target.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <random>
+#include <string>
+#include <vector>
+
+using k1::core::visual::InhouseWaveformAudio;
+using k1::core::visual::InhouseWaveformControls;
+using k1::core::visual::InhouseWaveformRenderer;
+using k1::core::visual::Pixel16;
+
+namespace {
+struct Hop final { k1_audio_hop_t hop; std::uint64_t capture_us; };
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc != 5 && argc != 9) {
+    std::fprintf(stderr, "usage: p6_dbs_probe in.s16 out_prefix arm(0-4) strength [plant onsets.txt offset_s scale]\n");
+    return 2;
+  }
+  const int arm = std::atoi(argv[3]);
+  const float strength = std::strtof(argv[4], nullptr);
+  if (arm < 0 || arm > 4 || !(strength >= 0.0F && strength <= 0.25F)) return 2;
+  const std::string plant = argc == 9 ? argv[5] : "none";
+  if (plant != "none" && plant != "uniform" && plant != "random" && plant != "oracle") return 2;
+  if (plant != "none" && arm != 2) return 2;
+  std::vector<double> onsets;
+  double offset = 0.0, scale = 1.0;
+  if (argc == 9) {
+    offset = std::strtod(argv[7], nullptr);
+    scale = std::strtod(argv[8], nullptr);
+    if (std::FILE* f = std::fopen(argv[6], "r")) {
+      for (double t; std::fscanf(f, "%lf", &t) == 1;) onsets.push_back(t);
+      std::fclose(f);
+    } else if (plant == "oracle") return 3;
+  }
+
+  std::FILE* in = std::fopen(argv[1], "rb");
+  if (!in) return 3;
+  std::vector<std::int16_t> pcm;
+  for (std::int16_t s; std::fread(&s, 2, 1, in) == 1;) pcm.push_back(s);
+  std::fclose(in);
+  const std::string prefix = argv[2];
+  std::FILE* ticks = std::fopen((prefix + ".ticks.csv").c_str(), "w");
+  std::FILE* hops = std::fopen((prefix + ".hops.csv").c_str(), "w");
+  std::FILE* bin = std::fopen((prefix + ".frames.bin").c_str(), "wb");
+  if (!ticks || !hops || !bin) return 3;
+
+  static k1::titan::InhouseAudio audio;
+  audio.reset();
+  k1::titan::InhouseAudioConfig config{};
+  config.analysis_rate_hz = k1::titan::kInhouseAnalysis24Rate;
+  if (!audio.configure(config)) return 5;
+  // Same setup as p6_effect_probe.cpp (both boards demand tempo; renderers reset).
+  audio.setTempoDemand(0, true);
+  audio.setTempoDemand(1, true);
+  static k1_poly24_t poly;
+  k1_poly24_reset(&poly, 40000U);
+  k1::core::audio::OnsetBeat onset;
+  std::vector<float> onset_by_generation;  // index = generation
+  std::uint64_t onset_read_generation = 0;  // board 0 host cursor for the onset injection
+  static InhouseWaveformRenderer renderer[2];
+  renderer[0].reset();
+  renderer[1].reset();
+  InhouseWaveformControls controls[2];
+  for (unsigned b = 0; b < 2; ++b) { controls[b].motion_scale = 0.5F * 2.0F; controls[b].mirror = true; }
+  controls[0].mode = 32; controls[0].palette_id = 32 - 1;
+  controls[1].mode = 18; controls[1].palette_id = 39 - 1;
+  controls[0].detail_arm = static_cast<std::uint8_t>(arm);
+  controls[0].detail_strength = strength;
+  k1::titan::InhouseAudioCursor cursor[2]{};
+  static Pixel16 frame[2][160];
+  std::mt19937 rng(20261015U);
+  std::uniform_real_distribution<float> unit(0.0F, 1.0F);
+  const auto cal = k1::core::visual::kInhouseDetailCalFullBank;
+
+  std::fprintf(ticks, "t_s,board,fresh_audio,silence,level,position,scroll_steps,deposit_peak,"
+                      "detail_attack,detail_gain,detail_valid,detail_fresh,detail_generation,"
+                      "partition_generation,intensity_mean\n");
+  std::fprintf(hops, "t_s,generation,capture_us,publish_us,valid,primed,quiet,support,full_bank,"
+                     "static16,adaptive16,partition_generation,selection_update,onset_transient\n");
+  constexpr unsigned kSlot = 296U;
+  constexpr std::uint64_t kOriginUs = 1000000U;
+  constexpr std::uint64_t kRenderUs = 10000U;
+  std::deque<Hop> queue;
+  std::uint64_t hop_seq = 0, next_tick = kOriginUs + kRenderUs;
+  for (std::size_t at = 0; at + kSlot <= pcm.size(); at += kSlot) {
+    if (k1_poly24_push(&poly, &pcm[at], kSlot) != k1_poly24_ok) return 6;
+    Hop h{};
+    while (k1_poly24_pull180(&poly, h.hop.pcm) == k1_poly24_ok) {
+      h.hop.contract_version = K1_PDM_TARGET_AUDIO_CONTRACT_VERSION;
+      h.hop.samples = K1_POLY24_OUT_FRAMES;
+      h.hop.analysis_rate_hz = K1_POLY24_OUT_HZ;
+      h.hop.stream_epoch = 1U;
+      h.hop.hop_sequence = hop_seq + 1U;
+      h.hop.analysis_begin = hop_seq * K1_POLY24_OUT_FRAMES;
+      h.hop.analysis_end_exclusive = h.hop.analysis_begin + K1_POLY24_OUT_FRAMES;
+      ++hop_seq;
+      h.capture_us = kOriginUs + h.hop.analysis_end_exclusive * 1000000ULL / K1_POLY24_OUT_HZ;
+      h.hop.capture_estimate_valid = 1;
+      h.hop.newest_sample_capture_estimate_us = h.capture_us;
+      queue.push_back(h);
+    }
+    const std::uint64_t now = kOriginUs + (at + kSlot) * 1000000ULL / 40000ULL;
+    while (next_tick <= now) {
+      const std::uint64_t tick = next_tick;
+      next_tick += kRenderUs;
+      while (!queue.empty() && queue.front().capture_us <= tick) {
+        const auto hop = queue.front();
+        queue.pop_front();
+        if (!audio.consume(hop.hop, hop.capture_us, true)) continue;
+        const std::uint64_t publish_us = std::min(hop.capture_us + 100U, tick);
+        audio.stampPublication(publish_us);
+        const auto& pub = audio.latest();
+        const auto& rec = audio.detailRecord();
+        float transient = 0.0F;
+        if (pub.valid) {
+          // Host comparator: OnsetBeat over this accepted publication's pre-gain bank (board 0).
+          InhouseWaveformAudio view{};
+          k1::titan::InhouseAudioCursor scratch{};
+          (void)audio.acquire(scratch, publish_us, 50000U, view, 0);
+          const bool quiet = view.silence && view.raw_rms < view.quiet_entry_rms;
+          k1::contract::AudioFeaturesV1 features{};
+          float energy = 0.0F, low = 0.0F;
+          for (unsigned bin = 0; bin < 80U; ++bin) { features.spectrum[bin] = view.linear_shape[bin]; energy += view.linear_shape[bin]; }
+          for (unsigned bin = 1; bin < 25U; ++bin) low += view.linear_shape[bin];
+          features.spectral_energy = energy / 80.0F;
+          features.novelty = view.novelty;
+          features.low_energy = low / 24.0F;
+          features.peak_scaled = std::clamp(view.peak_scaled, 0.0F, 1.0F);
+          features.nyquist_safe_bin_hi = 80;
+          features.source_frame_ms = static_cast<std::uint32_t>(hop.capture_us / 1000U);
+          features.event_flags = quiet ? k1::contract::kEventSilence : 0U;
+          features.validity_flags = k1::contract::kValidSpectrum;
+          if (view.valid) transient = onset.update(features).transient_strength;
+        }
+        if (onset_by_generation.size() <= pub.generation) onset_by_generation.resize(pub.generation + 1U, 0.0F);
+        onset_by_generation[pub.generation] = transient;
+        std::fprintf(hops, "%.6f,%llu,%llu,%llu,%d,%d,%d,%u,%.8g,%.8g,%.8g,%llu,%d,%.8g\n",
+                     static_cast<double>(hop.capture_us - kOriginUs) / 1.0e6,
+                     static_cast<unsigned long long>(rec.generation), static_cast<unsigned long long>(rec.capture_us),
+                     static_cast<unsigned long long>(rec.publish_us), rec.valid ? 1 : 0, rec.primed ? 1 : 0,
+                     rec.quiet ? 1 : 0, rec.support, rec.full_bank_mean_change, rec.static_partition.strength,
+                     rec.adaptive_partition.strength, static_cast<unsigned long long>(rec.partition_generation),
+                     rec.selection_update ? 1 : 0, transient);
+      }
+      const double t_s = static_cast<double>(tick - kOriginUs) / 1.0e6;
+      for (unsigned b = 0; b < 2; ++b) {
+        InhouseWaveformAudio a{};
+        (void)audio.acquire(cursor[b], tick, 50000U, a, b);
+        const bool confirmed_quiet = a.silence && a.raw_rms < a.quiet_entry_rms;
+        a.silence = confirmed_quiet;
+        a.peak_scaled = std::clamp(a.peak_scaled, 0.0F, 1.0F);
+        a.vu_level = std::clamp(a.vu_level, 0.0F, 1.0F);
+        a.vu_average = std::clamp(a.vu_average, 0.0F, 1.0F);
+        a.observed_peak_scaled = std::clamp(a.observed_peak_scaled, 0.0F, 1.0F);
+        if (b == 0U) {
+          // Onset injection: maximum over generations board 0 has not yet read (host cursor).
+          float m = 0.0F;
+          for (std::uint64_t g = onset_read_generation + 1U; g <= a.generation && g < onset_by_generation.size(); ++g)
+            m = std::max(m, onset_by_generation[g]);
+          if (a.generation > onset_read_generation) onset_read_generation = a.generation;
+          a.detail.onset = m;
+          if (plant != "none" && a.detail.valid) {
+            float x = cal.p50;
+            if (plant == "random") x = cal.p50 + unit(rng) * (cal.p95 - cal.p50);
+            if (plant == "oracle") {
+              const double song = (t_s - offset) / scale;
+              for (double o : onsets) if (song >= o && song <= o + 0.030) { x = cal.p95; break; }
+            }
+            a.detail.full_bank = x;
+            a.detail.fresh = true;
+          }
+        }
+        if (!renderer[b].render(a, controls[b], tick, frame[b], 160)) std::memset(frame[b], 0, sizeof frame[b]);
+        std::fwrite(frame[b], sizeof(Pixel16), 160, bin);
+        const auto& o = renderer[b].observation();
+        std::fprintf(ticks, "%.6f,%u,%d,%d,%.8g,%.8g,%u,%.8g,%.8g,%.8g,%d,%d,%llu,%llu,%.8g\n", t_s, b,
+                     o.input_fresh ? 1 : 0, a.silence ? 1 : 0, o.level, o.position, o.scroll_steps,
+                     o.deposit_peak, o.detail_attack, o.detail_gain, a.detail.valid ? 1 : 0,
+                     a.detail.fresh ? 1 : 0, static_cast<unsigned long long>(a.detail.generation),
+                     static_cast<unsigned long long>(a.detail.partition_generation), o.intensity_mean);
+      }
+    }
+  }
+  std::fclose(ticks);
+  std::fclose(hops);
+  std::fclose(bin);
+  return 0;
+}
