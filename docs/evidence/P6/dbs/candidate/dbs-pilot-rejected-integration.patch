+int main() {
+  struct Case { const char* name; bool (*run)(); };
+  const Case cases[] = {
+      {"test1 legal splits and coverage", test1}, {"test2 priming and step", test2},
+      {"test3 duplicate and resets", test3},      {"test4 causality", test4},
+      {"test5 no partition-created attacks", test5}, {"test6 hysteresis and ties", test6},
+      {"test7 quiet", test7},                     {"test8 cadence", test8},
+      {"test9 trivially copyable", test9}};
+  int failures = 0;
+  for (const auto& c : cases) {
+    const bool ok = c.run();
+    std::printf("%s: %s\n", c.name, ok ? "ok" : "FAIL");
+    failures += ok ? 0 : 1;
+  }
+  std::printf("sizeof(AdaptiveSpectralDetail)=%zu sizeof(DetailRecord)=%zu sizeof(DetailPartition)=%zu "
+              "sizeof(DetailGroup)=%zu\n", sizeof(AdaptiveSpectralDetail), sizeof(DetailRecord),
+              sizeof(DetailPartition), sizeof(DetailGroup));
+  return failures == 0 ? 0 : 1;
+}
