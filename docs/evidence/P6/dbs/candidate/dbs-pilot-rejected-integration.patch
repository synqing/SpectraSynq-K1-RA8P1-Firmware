+bool test9() {
+  const char* tag = "test9";
+  bool ok = true;
+  CHECK(std::is_trivially_copyable_v<DetailRecord>);
+  CHECK(std::is_trivially_copyable_v<AdaptiveSpectralDetail>);
+  CHECK(std::is_trivially_copyable_v<DetailInput>);
