{
  "schema": 2,
  "transport": "host-ndjson",
  "not_cdc_bytes": true,
  "cdc_request_magic": "K1S1",
  "cdc_response_magic": "K1R1",
  "unavailable": "UNAVAILABLE",
  "numeric_fields_are_json_numbers": true,
  "sequence_is_string": true,
  "mode_labels": [
    "DISCONNECTED",
    "IDENTIFYING",
    "READY",
    "LIVE",
    "TESTING",
    "COMPLETED",
    "FAULT",
    "REPLAY",
    "DEBUG HALTED",
    "STALE"
  ],
  "gate_result_labels": ["NONE", "RUNNING", "PASSED", "FAILED", "NOT SUPPORTED"],
  "slots_1based": {
    "1": "banner",
    "2": "operating_state",
    "3": "test_result",
    "4": "uid",
    "5": "build",
    "6": "source",
    "7": "contract",
    "8": "identity_ok",
    "9": "lane_a_rms",
    "10": "lane_b_rms",
    "11": "lane_a_valid",
    "12": "lane_b_valid",
    "13": "capture_rate_hz",
    "14": "hop_max_us",
    "15": "late_starts",
    "16": "deadlines",
    "17": "crc_mismatches",
    "18": "led_health",
    "19": "dma_irqs",
    "20": "latched_frames",
    "21": "led_faults",
    "22": "hop_samples",
    "23": "admitted_rate_hz",
    "24": "sequence",
    "25": "health_valid",
    "26": "simulated",
    "27": "audio_mapping",
    "28": "origin (schema 3)",
    "29": "identity_scope (schema 3)",
    "30": "device_age_ms (schema 3)",
    "31": "device_progress (schema 3)",
    "32": "connection_epoch (schema 3)",
    "33": "timing_valid (schema 3)",
    "34": "rate_valid (schema 3)",
    "35": "led_valid (schema 3)",
    "36": "frozen_device (schema 3)"
  },
  "rules": [
    "When a validity flag is true, the matching measurements must be present.",
    "When a validity flag is false, those measurements must be absent and display UNAVAILABLE.",
    "Never default CRC/LED faults to 0, RMS to 0 dBFS, or hop/rate to 180/24000.",
    "identity_ok=1 requires uid, build, source, contract strings.",
    "Host stale is a watchdog table, not a fixture flag."
  ]
}
